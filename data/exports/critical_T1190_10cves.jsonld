  {
   "@id": "https://nvd.nist.gov/vuln/detail/CVE-2014-7169",
   "@type": "Vulnerability",
   "cveId": "CVE-2014-7169",
   "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2014-7169/",
   "vendorProject": "GNU",
   "product": "Bourne-Again Shell (Bash)",
   "title": "GNU Bourne-Again Shell (Bash) Arbitrary Code Execution Vulnerability",
   "dateAdded": "2022-01-28",
   "dueDate": "2022-07-28",
   "shortDescription": "GNU Bash through 4.3 processes trailing strings after function definitions in the values of environment variables, which allows remote attackers to execute code. This CVE correctly remediates the vulnerability in CVE-2014-6271.",
   "requiredAction": "Apply updates per vendor instructions.",
   "ransomwareUse": "unknown",
   "notes": "https://nvd.nist.gov/vuln/detail/CVE-2014-7169",
   "dueBeforeAdded": false,
   "weakness": [
    {
     "@id": "https://cwe.mitre.org/data/definitions/78.html",
     "@type": "Weakness",
     "cweId": "CWE-78",
     "isInformative": true
    }
   ],
   "nvd": {
    "@type": "NvdRecord",
