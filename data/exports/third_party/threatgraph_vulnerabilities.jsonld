: "tg:dateAdded", "@type": "xsd:date"}, "dueDate": {"@id": "tg:dueDate", "@type": "xsd:date"}, "ransomwareUse": "tg:ransomwareUse", "notes": "tg:notes", "dueBeforeAdded": "tg:dueBeforeAdded", "weakness": {"@id": "tg:weakness", "@container": "@set"}, "nvd": "tg:nvdRecord", "mappings": {"@id": "tg:hasMapping", "@container": "@set"}, "cweId": "tg:cweId", "isInformative": "tg:isInformative", "vulnStatus": "tg:vulnStatus", "published": {"@id": "dcterms:issued", "@type": "xsd:dateTime"}, "nReferences": "tg:nReferences", "cvssV31": "tg:cvssV31", "cvssV2Score": {"@id": "tg:cvssV2Score", "@type": "xsd:decimal"}, "score": {"@id": "tg:baseScore", "@type": "xsd:decimal"}, "severity": "tg:severity", "vector": "tg:vector", "metricSource": "tg:metricSource", "metricType": "tg:metricType", "weaknessAssignment": {"@id": "tg:weaknessAssignment", "@container": "@set"}, "assignedBy": "tg:assignedBy", "assignmentType": "tg:assignmentType", "techniqueId": "tg:techniqueId", "tacticId": "tg:tacticId", "shortname": "tg:shortname", "status": "tg:status", "isSubtechnique": "tg:isSubtechnique", "created": {"@id": "dcterms:created", "@type": "xsd:dateTime"}, "modified": {"@id": "dcterms:modified", "@type": "xsd:dateTime"}, "parentTechnique": {"@id": "tg:parentTechnique", "@type": "@id"}, "subtechnique": {"@id": "tg:subtechnique", "@type": "@id", "@container": "@set"}, "tactic": {"@id": "tg:tactic", "@container": "@set"}, "technique": "tg:technique", "vulnerability": "tg:vulnerability", "mappingType": "tg:mappingType", "capabilityGroup": "tg:capabilityGroup", "comments": "tg:comments", "evidence": {"@id": "tg:evidence", "@container": "@set"}, "evidenceUrl": {"@id": "tg:evidenceUrl", "@type": "@id", "@container": "@set"}, "version": "dcterms:hasVersion", "publisher": "dcterms:publisher", "rights": "dcterms:rights", "sha256": "tg:sha256", "contentId": "tg:contentId", "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"}, "rawManifestSha256": "tg:rawManifestSha256", "cleaningCodeSha256": "tg:cleaningCodeSha256", "rowCount": "tg:rowCount", "distribution": {"@id": "dcat:distribution", "@container": "@set"}, "accessURL": {"@id": "dcat:accessURL", "@type": "@id"}, "mediaType": {"@id": "dcat:mediaType", "@container": "@set"}, "tables": "tg:tables", "totalItems": "tg:totalItems", "nextPage": {"@id": "tg:nextPage", "@type": "@id"}, "previousPage": {"@id": "tg:previousPage", "@type": "@id"}}, "@id": "https://nvd.nist.gov/vuln/detail/CVE-2018-11776", "@type": "Vulnerability", "cveId": "CVE-2018-11776", "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2018-11776/", "vendorProject": "Apache", "product": "Struts", "title": "Apache Struts Remote Code Execution Vulnerability", "dateAdded": "2021-11-03", "dueDate": "2022-05-03", "shortDescription": "Apache Struts contains a vulnerability that allows for remote code execution under two circumstances. One, where the alwaysSelectFullNamespace option is true and the value isn't set for a result defined in underlying configurations and in same time, its upper package configuration have no or wildcard namespace.  Or, using URL tag which doesn't have value and action set and in same time, its upper package configuration have no or wildcard namespace.", "requiredAction": "Apply updates per vendor instructions.", "ransomwareUse": "unknown", "notes": "https://nvd.nist.gov/vuln/detail/CVE-2018-11776", "dueBeforeAdded": false, "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/20.html", "@type": "Weakness", "cweId": "CWE-20", "isInformative": true}], "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2018-08-22T13:29:00.753000Z", "modified": "2025-03-13T21:01:25.353000Z", "description": "Apache Struts versions 2.3 to 2.3.34 and 2.5 to 2.5.16 suffer from possible Remote Code Execution when alwaysSelectFullNamespace is true (either by user or a plugin like Convention Plugin) and then: results are used with no namespace and in same time, its upper package have no or wildcard namespace and similar to results, same possibility when using url tag which doesn't have value and action set and in same time, its upper package have no or wildcard namespace.", "cvssV31": {"@type": "CvssV31", "score": 8.1, "severity": "HIGH", "vector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H", "metricSource": "nvd@nist.gov", "metricType": "Primary"}, "cvssV2Score": 9.3, "nReferences": 38, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "urn:threatgraph:weakness:NVD-CWE-noinfo", "@type": "Weakness", "cweId": "NVD-CWE-noinfo", "isInformative": false}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:723", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "code_execution", "comments": "CVE-2018-11776 is a remote code execution vulnerability in the Apache Struts web application framework that could allow remote attackers to run malicious code on the affected servers when alwaysSelectFullNamespace is true and then results are used with no namespace.", "evidenceUrl": ["https://www.keysight.com/blogs/en/tech/nwvs/2022/06/03/strutting-to-remote-code-execution-anatomy-of-cve-2018-11776", "https://www.volexity.com/blog/2018/08/27/active-exploitation-of-new-apache-struts-vulnerability-cve-2018-11776-deploys-cryptocurrency-miner/"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1190/", "@type": "AttackTechnique", "techniqueId": "T1190", "name": "Exploit Public-Facing Application", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0001/", "@type": "AttackTactic", "tacticId": "TA0001", "shortname": "initial-access"}]}}, {"@id": "urn:threatgraph:pkev-mapping:724", "@type": "Mapping", "mappingType": 