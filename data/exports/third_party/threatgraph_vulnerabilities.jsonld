vulnStatus", "published": {"@id": "dcterms:issued", "@type": "xsd:dateTime"}, "nReferences": "tg:nReferences", "cvssV31": "tg:cvssV31", "cvssV2Score": {"@id": "tg:cvssV2Score", "@type": "xsd:decimal"}, "score": {"@id": "tg:baseScore", "@type": "xsd:decimal"}, "severity": "tg:severity", "vector": "tg:vector", "metricSource": "tg:metricSource", "metricType": "tg:metricType", "weaknessAssignment": {"@id": "tg:weaknessAssignment", "@container": "@set"}, "assignedBy": "tg:assignedBy", "assignmentType": "tg:assignmentType", "techniqueId": "tg:techniqueId", "tacticId": "tg:tacticId", "shortname": "tg:shortname", "status": "tg:status", "isSubtechnique": "tg:isSubtechnique", "created": {"@id": "dcterms:created", "@type": "xsd:dateTime"}, "modified": {"@id": "dcterms:modified", "@type": "xsd:dateTime"}, "parentTechnique": {"@id": "tg:parentTechnique", "@type": "@id"}, "subtechnique": {"@id": "tg:subtechnique", "@type": "@id", "@container": "@set"}, "tactic": {"@id": "tg:tactic", "@container": "@set"}, "technique": "tg:technique", "vulnerability": "tg:vulnerability", "mappingType": "tg:mappingType", "capabilityGroup": "tg:capabilityGroup", "comments": "tg:comments", "evidence": {"@id": "tg:evidence", "@container": "@set"}, "evidenceUrl": {"@id": "tg:evidenceUrl", "@type": "@id", "@container": "@set"}, "version": "dcterms:hasVersion", "publisher": "dcterms:publisher", "rights": "dcterms:rights", "sha256": "tg:sha256", "contentId": "tg:contentId", "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"}, "rawManifestSha256": "tg:rawManifestSha256", "cleaningCodeSha256": "tg:cleaningCodeSha256", "rowCount": "tg:rowCount", "distribution": {"@id": "dcat:distribution", "@container": "@set"}, "accessURL": {"@id": "dcat:accessURL", "@type": "@id"}, "mediaType": {"@id": "dcat:mediaType", "@container": "@set"}, "tables": "tg:tables", "totalItems": "tg:totalItems", "nextPage": {"@id": "tg:nextPage", "@type": "@id"}, "previousPage": {"@id": "tg:previousPage", "@type": "@id"}}, "@id": "https://nvd.nist.gov/vuln/detail/CVE-2023-0669", "@type": "Vulnerability", "cveId": "CVE-2023-0669", "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2023-0669/", "vendorProject": "Fortra", "product": "GoAnywhere MFT", "title": "Fortra GoAnywhere MFT Remote Code Execution Vulnerability", "dateAdded": "2023-02-10", "dueDate": "2023-03-03", "shortDescription": "Fortra (formerly, HelpSystems) GoAnywhere MFT contains a pre-authentication remote code execution vulnerability in the License Response Servlet due to deserializing an attacker-controlled object.", "requiredAction": "Apply updates per vendor instructions.", "ransomwareUse": "known", "notes": "This CVE has a CISA AA located here: https://www.cisa.gov/news-events/cybersecurity-advisories/aa23-158a. Please see the AA for associated IOCs. Additional information is available at: https://my.goanywhere.com/webclient/DownloadProductFiles.xhtml. Fortra users must have an account in order to login and access the patch.;  https://nvd.nist.gov/vuln/detail/CVE-2023-0669", "dueBeforeAdded": false, "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/502.html", "@type": "Weakness", "cweId": "CWE-502", "isInformative": true}], "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2023-02-06T20:15:14.300000Z", "modified": "2025-03-06T20:11:58.860000Z", "description": "Fortra (formerly, HelpSystems) GoAnywhere MFT suffers from a pre-authentication command injection vulnerability in the License Response Servlet due to deserializing an arbitrary attacker-controlled object. This issue was patched in version 7.1.2.", "cvssV31": {"@type": "CvssV31", "score": 7.2, "severity": "HIGH", "vector": "CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H", "metricSource": "nvd@nist.gov", "metricType": "Primary"}, "nReferences": 16, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/502.html", "@type": "Weakness", "cweId": "CWE-502", "isInformative": true}], "assignedBy": "134c704f-9b21-4f2e-91b3-4a467353bcc0", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/502.html", "@type": "Weakness", "cweId": "CWE-502", "isInformative": true}], "assignedBy": "cve@rapid7.com", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/502.html", "@type": "Weakness", "cweId": "CWE-502", "isInformative": true}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:566", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "code_execution", "comments": "This vulnerability is exploited through a cross-site request forgery (CSRF) flaw in GoAnywhere's license installation process. Attackers initiate this vulnerability by leveraging the absence of CSRF protection, allowing them to execute remote code without authentication. This enables them to compromise targeted systems, facilitating ransomware attacks and unauthorized access. This vulnerability has been actively exploited, leading to ransomware attacks by the Clop group.", "evidenceUrl": ["https://attackerkb.com/topics/mg883Nbeva/cve-2023-0669/rapid7-analysis", "https://packetstormsecurity.com/files/171789/Goanywhere-Encryption-Helper-7.1.1-Remote-Code-Execution.html", "https://www.darkreading.com/cyberattacks-data-breaches/fortra-discloses-critical-auth-bypass-vuln-in-goanywhere-mft", "https://www.darkreading.com/endpoint-security/massive-goanywhere-rce-exploit"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1190/", "@type": "AttackTechnique", "techniqueId": "T1190", "name": "Exploit Public-Facing Application", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0001/", "@type": "AttackTactic", "tacticId": "TA0001", "shortname": "initial-access"}]}}, {"@id": "urn:threatgraph:pkev-mapping:567", "@type": "Mapping", "mappingType": "secondary_impact", "capabilityGroup": "code_execution", "comments": "This vulnerability is exploited through a cross-site request forgery (CSRF) flaw in GoAnywhere's license installation process. Attackers initiate this vulnerability by leveraging the absence of CSRF protection, allowing them to execute remote code without authentication. This enables them to compromise targeted systems, facilitating ransomware attacks and unauthorized access. This vulnerability has been actively exploited, leading to ransomware attacks by the Clop group.", "evidenceUrl": ["https://attackerkb.com/topics/mg883Nbeva/cve-2023-0669/rapid7-analysis", "https://packetstormsecurity.com/files/171789/Goanywhere-Encryption-Helper-7.1.1-Remote-Code-Execution.html", "https://www.darkreading.com/cyberattacks-data-breaches/fortra-discloses-critical-auth-bypass-vuln-in-goanywhere-mft", "https://www.darkreading.com/endpoint-security/massive-goanywhere-rce-exploit"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1486/", "@type": "AttackTechnique", "techniqueId": "T1486", "name": "Data Encrypted for Impact", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0040/", "@type": "AttackTactic", "tacticId": "TA0040", "shortname": "impact"}]}}, {"@id": "urn:threatgraph:pkev-mapping:568", "@type": "Mapping", "mappingType": "primary_impact", "capabilityGroup": "code_execution", "comments": "This vulnerability is exploited through a cross-site request forgery (CSRF) flaw in GoAnywhere's license installation process. Attackers initiate this vulnerability by leveraging the absence of CSRF protection, allowing them to execute remote code without authentication. This enables them to compromise targeted systems, facilitating ransomware attacks and unauthorized access. This vulnerability has been actively exploited, leading to ransomware attacks by the Clop group.", "evidenceUrl": ["https://attackerkb.com/topics/mg883Nbeva/cve-2023-0669/rapid7-analysis", "https://packetstormsecurity.com/files/171789/Goanywhere-Encryption-Helper-7.1.1-Remote-Code-Execution.html", "https://www.darkreading.com/cyberattacks-data-breaches/fortra-discloses-critical-auth-bypass-vuln-in-goanywhere-mft", "https://www.darkreading.com/endpoint-security/massive-goanywhere-rce-exploit"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1210/", "@type": "AttackTechnique", "techniqueId": "T1210", "name": "Exploitation of Remote Services", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0008/", "@type": "AttackTactic", "tacticId": "TA0008", "shortname": "lateral-movement"}]}}], "wasDerivedFrom": ["https://github.com/cisagov/kev-data/tree/0cca62ed469c333a45760beeaf35fcc53352aedd"]}, {"@context": {"tg": "https://example.org/threatgraph/vocab#", "dcterms": "http://purl.org/dc/terms/", "dcat": "http://www.w3.org/ns/dcat#", "prov": "http://www.w3.org/ns/prov#", "rdfs": "http://www.w3.org/2000/01/rdf-schema#", "xsd": "http://www.w3.org/2001/XMLSchema#", "Vulnerability": "tg:Vulnerability", "NvdRecord": "tg:NvdRecord", "CvssV31": "tg:CvssV31", "Weakness": "tg:Weakness", "WeaknessAssignment": "tg:WeaknessAssignment", "AttackTechnique": "tg:AttackTechnique", "AttackTactic": "tg:AttackTactic", "Mapping": "tg:Mapping", "Dataset": "dcat:Dataset", "Distribution": "dcat:Distribution", "apiUrl": {"@id": "tg:apiUrl", "@type": "@id"}, "wasDerivedFrom": {"@id": "prov:wasDerivedFrom", "@type": "@id", "@container": "@set"}, "name": "rdfs:label", "description": "dcterms:description", "title": "dcterms:title", "cveId": "dcterms:identifier", "vendorProject": "tg:vendorProject", "product": "tg:product", "shortDescription": "tg:shortDescription", "requiredAction": "tg:requiredAction", "dateAdded": {"@id": "tg:dateAdded", "@type": "xsd:date"}, "dueDate": {"@id": "tg:dueDate", "@type": "xsd:date"}, "ransomwareUse": "tg:ransomwareUse", "notes": "tg:notes", "dueBeforeAdded": "tg:dueBeforeAdded", "weakness": {"@id": "tg:weakness", "@container": "@set"}, "nvd": "tg:nvdRecord", "mappings": {"@id": "tg:hasMapping", "@container": "@set"}, "cweId": "tg:cweId", "isInformative": "tg:isInformative", "vulnStatus": "tg:vulnStatus", "published": {"@id": "dcterms:issued", "@type": "xsd:dateTime"}, "nReferences": "tg:nReferences", "cvssV31": "tg:cvssV31", "cvssV2Score": {"@id": "tg:cvssV2Score", "@type": "xsd:decimal"}, "score": {"@id": "tg:baseScore", "@type": "xsd:decimal"}, "severity": "tg:severity", "vector": "tg:vector", "metricSource": "tg:metricSource", "metricType": "tg:metricType", "weaknessAssignment": {"@id": "tg:weaknessAssignment", "@container": "@set"}, "assignedBy": "tg:assignedBy", "assignmentType": "tg:assignmentType", "techniqueId": "tg:techniqueId", "tacticId": "tg:tacticId", "shortname": "tg:shortname", "status": "tg:status", "isSubtechnique": "tg:isSubtechnique", "created": {"@id": "dcterms:created", "@type": "xsd:dateTime"}, "modified": {"@id": "dcterms:modified", "@type": "xsd:dateTime"}, "parentTechnique": {"@id": "tg:parentTechnique", "@type": "@id"}, "subtechnique": {"@id": "tg:subtechnique", "@type": "@id", "@container": "@set"}, "tactic": {"@id": "tg:tactic", "@container": "@set"}, "technique": "tg:technique", "vulnerability": "tg:vulnerability", "mappingType": "tg:mappingType", "capabilityGroup": "tg:capabilityGroup", "comments": "tg:comments", "evidence": {"@id": "tg:evidence", "@container": "@set"}, "evidenceUrl": {"@id": "tg:evidenceUrl", "@type": "@id", "@container": "@set"}, "version": "dcterms:hasVersion", "publisher": "dcterms:publisher", "rights": "dcterms:rights", "sha256": "tg:sha256", "contentId": "tg:contentId", "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"}, "rawManifestSha256": "tg:rawManifestSha256", "cleaningCodeSha256": "tg:cleaningCodeSha256", "rowCount": "tg:rowCount", "distribution": {"@id": "dcat:distribution", "@container": "@set"}, "accessURL": {"@id": "dcat:accessURL", "@type": "@id"}, "mediaType": {"@id": "dcat:mediaType", "@container": "@set"}, "tables": "tg:tables", "totalItems": "tg:totalItems", "nextPage": {"@id": "tg:nextPage", "@type": "@id"}, "previousPage": {"@id": "tg:previousPage", "@type": "@id"}}, "@id": "https://nvd.nist.gov/vuln/detail/CVE-2023-22515", "@type": "Vulnerability", "cveId": "CVE-2023-22515", "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2023-22515/", "vendorProject": "Atlassian", "product": "Confluence Data Center and Server", "title": "Atlassian Confluence Data Center and Server Broken Access Control Vulnerability", "dateAdded": "2023-10-05", "dueDate": "2023-10-13", "shortDescription": "Atlassian Confluence Data Center and Server contains a broken access control vulnerability that allows an attacker to create unauthorized Confluence administrator accounts and access Confluence.", "requiredAction": "Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable. Check all affected Confluence instances for evidence of compromise per vendor instructions and report any positive findings to CISA.", "ransomwareUse": "known", "notes": "https://confluence.atlassian.com/security/cve-2023-22515-privilege-escalation-vulnerability-in-confluence-data-center-and-server-1295682276.html;  https://nvd.nist.gov/vuln/detail/CVE-2023-22515", "dueBeforeAdded": false, "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2023-10-04T14:15:10.440000Z", "modified": "2025-02-09T20:49:55.073000Z", "description": "Atlassian has been made aware of an issue reported by a handful of customers where external attackers may have exploited a previously unknown vulnerability in publicly accessible Confluence Data Center and Server instances to create unauthorized Confluence administrator accounts and access Confluence instances. \r\n\r\nAtlassian Cloud sites are not affected by this vulnerability. If your Confluence site is accessed via an atlassian.net domain, it is hosted by Atlassian and is not vulnerable to this issue.", "cvssV31": {"@type": "CvssV31", "score": 9.8, "severity": "CRITICAL", "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "metricSource": "nvd@nist.gov", "metricType": "Primary"}, "nReferences": 8, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/20.html", "@type": "Weakness", "cweId": "CWE-20", "isInformative": true}], "assignedBy": "134c704f-9b21-4f2e-91b3-4a467353bcc0", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "urn:threatgraph:weakness:NVD-CWE-noinfo", "@type": "Weakness", "cweId": "NVD-CWE-noinfo", "isInformative": false}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:934", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "access_ctrl", "comments": "This vulnerability is exploited through improper input validation in Atlassian Confluence, allowing remote attackers to translate arbitrary HTTP parameters into getter/setter sequences via the XWorks2 middleware. This vulnerability enables the creation of unauthorized Confluence administrator accounts and the upload of malicious plugins, granting attackers the ability to modify Java objects at runtime and execute arbitrary code. A nation-state actor known as Storm-0062 has been attributed to exploiting this vulnerability in the wild.", "evidenceUrl": ["https://packetstormsecurity.com/files/175225/Atlassian-Confluence-Unauthenticated-Remote-Code-Execution.html", "https://thehackernews.com/2023/10/microsoft-warns-of-nation-state-hackers.html"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1190/", "@type": "AttackTechnique", "techniqueId": "T1190", "name": "Exploit Public-Facing Application", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0001/", "@type": "AttackTactic", "tacticId": "TA0001", "shortname": "initial-access"}]}}, {"@id": "urn:threatgraph:pkev-mapping:935", "@type": "Mapping", "mappingType": "secondary_impact", "capabilityGroup": "access_ctrl", "comments": "This vulnerability is exploited through improper input validation in Atlassian Confluence, allowing remote attackers to translate arbitrary HTTP parameters into getter/setter sequences via the XWorks2 middleware. This vulnerability enables the creation of unauthorized Confluence administrator accounts and the upload of malicious plugins, granting attackers the ability to modify Java objects at runtime and execute arbitrary code. A nation-state actor known as Storm-0062 has been attributed to exploiting this vulnerability in the wild.", "evidenceUrl": ["https://packetstormsecurity.com/files/175225/Atlassian-Confluence-Unauthenticated-Remote-Code-Execution.html", "https://thehackernews.com/2023/10/microsoft-warns-of-nation-state-hackers.html"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1078/", "@type": "AttackTechnique", "techniqueId": "T1078", "name": "Valid Accounts", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0001/", "@type": "AttackTactic", "tacticId": "TA0001", "shortname": "initial-access"}, {"@id": "https://attack.mi