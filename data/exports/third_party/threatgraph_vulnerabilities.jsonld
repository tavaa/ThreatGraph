ue", "@type": "@id", "@container": "@set"}, "tactic": {"@id": "tg:tactic", "@container": "@set"}, "technique": "tg:technique", "vulnerability": "tg:vulnerability", "mappingType": "tg:mappingType", "capabilityGroup": "tg:capabilityGroup", "comments": "tg:comments", "evidence": {"@id": "tg:evidence", "@container": "@set"}, "evidenceUrl": {"@id": "tg:evidenceUrl", "@type": "@id", "@container": "@set"}, "version": "dcterms:hasVersion", "publisher": "dcterms:publisher", "rights": "dcterms:rights", "sha256": "tg:sha256", "contentId": "tg:contentId", "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"}, "rawManifestSha256": "tg:rawManifestSha256", "cleaningCodeSha256": "tg:cleaningCodeSha256", "rowCount": "tg:rowCount", "distribution": {"@id": "dcat:distribution", "@container": "@set"}, "accessURL": {"@id": "dcat:accessURL", "@type": "@id"}, "mediaType": {"@id": "dcat:mediaType", "@container": "@set"}, "tables": "tg:tables", "totalItems": "tg:totalItems", "nextPage": {"@id": "tg:nextPage", "@type": "@id"}, "previousPage": {"@id": "tg:previousPage", "@type": "@id"}}, "@id": "https://nvd.nist.gov/vuln/detail/CVE-2025-54309", "@type": "Vulnerability", "cveId": "CVE-2025-54309", "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2025-54309/", "vendorProject": "CrushFTP", "product": "CrushFTP", "title": "CrushFTP Unprotected Alternate Channel Vulnerability", "dateAdded": "2025-07-22", "dueDate": "2025-08-12", "shortDescription": "CrushFTP contains an unprotected alternate channel vulnerability. When the DMZ proxy feature is not used, mishandles AS2 validation and consequently allows remote attackers to obtain admin access via HTTPS.", "requiredAction": "Apply mitigations per vendor instructions, follow applicable BOD 22-01 guidance for cloud services, or discontinue use of the product if mitigations are unavailable.", "ransomwareUse": "unknown", "notes": "https://www.crushftp.com/crush11wiki/Wiki.jsp?page=CompromiseJuly2025 ; https://nvd.nist.gov/vuln/detail/CVE-2025-54309", "dueBeforeAdded": false, "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/420.html", "@type": "Weakness", "cweId": "CWE-420", "isInformative": true}], "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2025-07-18T19:15:25.353000Z", "modified": "2025-07-23T17:51:56.027000Z", "description": "CrushFTP 10 before 10.8.5 and 11 before 11.3.4_23, when the DMZ proxy feature is not used, mishandles AS2 validation and consequently allows remote attackers to obtain admin access via HTTPS, as exploited in the wild in July 2025.", "cvssV31": {"@type": "CvssV31", "score": 9.8, "severity": "CRITICAL", "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "metricSource": "nvd@nist.gov", "metricType": "Primary"}, "nReferences": 3, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/420.html", "@type": "Weakness", "cweId": "CWE-420", "isInformative": true}], "assignedBy": "cve@mitre.org", "assignmentType": "Secondary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:908", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "auth_bypass", "comments": "Improper validation of AS2 messages in CrushFTP without DMZ proxy enabled were reported to be exploited to bypass authentication and gain administrative access over HTTPS, leading to system compromise, data exfiltration, and lateral movement.", "evidenceUrl": ["https://www.crushftp.com/crush11wiki/Wiki.jsp?page=CompromiseJuly2025", "https://zeropath.com/blog/crushftp-cve-2025-54309-as2-validation-flaw"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1068/", "@type": "AttackTechnique", "techniqueId": "T1068", "name": "Exploitation for Privilege Escalation", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0004/", "@type": "AttackTactic", "tacticId": "TA0004", "shortname": "privilege-escalation"}]}}, {"@id": "urn:threatgraph:pkev-mapping:909", "@type": "Mapping", "mappingType": "primary_impact", "capabilityGroup": "auth_bypass", "comments": "Improper validation of AS2 messages in CrushFTP without DMZ proxy enabled were reported to be exploited to bypass authentication and gain administrative access over HTTPS, leading to system compromise, data exfiltration, and lateral movement.", "evidenceUrl": ["https://www.crushftp.com/crush11wiki/Wiki.jsp?page=CompromiseJuly2025", "https://zeropath.com/blog/crushftp-cve-2025-54309-as2-validation-flaw"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1567/", "@type": "AttackTechnique", "techniqueId": "T1567", "name": "Exfiltration Over Web Service", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0010/", "@type": "AttackTactic", "tacticId": "TA0010", "shortname": "exfiltration"}]}}, {"@id": "urn:threatgraph:pkev-mapping:910", "@type": "Mapping", "mappingType": "secondary_impact", "capabilityGroup": "auth_bypass", "comments": "Improper validation of AS2 messages in CrushFTP without DMZ proxy enabled were reported to be exploited to bypass authentication and gain administrative access over HTTPS, leading to system compromise, data exfiltration, and lateral movement.", "evidenceUrl": ["https://www.crushftp.com/crush11wiki/Wiki.jsp?page=CompromiseJuly2025", "https://zeropath.com/blog/crushftp-cve-2025-54309-as2-validation-flaw"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1021/", "@type": "AttackTechnique", "techniqueId": "T1021", "name": "Remote Services", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0008/", "@type": "AttackTactic", "tacticId": "TA0008", "shortname": "lateral-movement"}]}}], "wasDerivedFrom": ["https://github.com/cisagov/kev-data/tree/0cca62ed469c333a45760beeaf35fcc53352aedd"]}]