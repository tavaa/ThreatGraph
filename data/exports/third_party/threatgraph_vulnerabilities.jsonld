ified", "@type": "xsd:dateTime"}, "parentTechnique": {"@id": "tg:parentTechnique", "@type": "@id"}, "subtechnique": {"@id": "tg:subtechnique", "@type": "@id", "@container": "@set"}, "tactic": {"@id": "tg:tactic", "@container": "@set"}, "technique": "tg:technique", "vulnerability": "tg:vulnerability", "mappingType": "tg:mappingType", "capabilityGroup": "tg:capabilityGroup", "comments": "tg:comments", "evidence": {"@id": "tg:evidence", "@container": "@set"}, "evidenceUrl": {"@id": "tg:evidenceUrl", "@type": "@id", "@container": "@set"}, "version": "dcterms:hasVersion", "publisher": "dcterms:publisher", "rights": "dcterms:rights", "sha256": "tg:sha256", "contentId": "tg:contentId", "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"}, "rawManifestSha256": "tg:rawManifestSha256", "cleaningCodeSha256": "tg:cleaningCodeSha256", "rowCount": "tg:rowCount", "distribution": {"@id": "dcat:distribution", "@container": "@set"}, "accessURL": {"@id": "dcat:accessURL", "@type": "@id"}, "mediaType": {"@id": "dcat:mediaType", "@container": "@set"}, "tables": "tg:tables", "totalItems": "tg:totalItems", "nextPage": {"@id": "tg:nextPage", "@type": "@id"}, "previousPage": {"@id": "tg:previousPage", "@type": "@id"}}, "@id": "https://nvd.nist.gov/vuln/detail/CVE-2021-37975", "@type": "Vulnerability", "cveId": "CVE-2021-37975", "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2021-37975/", "vendorProject": "Google", "product": "Chromium V8", "title": "Google Chromium V8 Use-After-Free Vulnerability", "dateAdded": "2021-11-03", "dueDate": "2021-11-17", "shortDescription": "Google Chromium V8 Engine contains a use-after-free vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.", "requiredAction": "Apply updates per vendor instructions.", "ransomwareUse": "unknown", "notes": "https://nvd.nist.gov/vuln/detail/CVE-2021-37975", "dueBeforeAdded": false, "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/416.html", "@type": "Weakness", "cweId": "CWE-416", "isInformative": true}], "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2021-10-08T22:15:08.373000Z", "modified": "2025-02-19T19:37:44.870000Z", "description": "Use after free in V8 in Google Chrome prior to 94.0.4606.71 allowed a remote attacker to potentially exploit heap corruption via a crafted HTML page.", "cvssV31": {"@type": "CvssV31", "score": 8.8, "severity": "HIGH", "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H", "metricSource": "nvd@nist.gov", "metricType": "Primary"}, "cvssV2Score": 6.8, "nReferences": 14, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/416.html", "@type": "Weakness", "cweId": "CWE-416", "isInformative": true}], "assignedBy": "134c704f-9b21-4f2e-91b3-4a467353bcc0", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/416.html", "@type": "Weakness", "cweId": "CWE-416", "isInformative": true}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:15", "@type": "Mapping", "mappingType": "primary_impact", "capabilityGroup": "use_after_free", "comments": "CVE-2021-37975 allows an adversary to use JavaScript to exploit the Chromium browser V8 JavaScript engine which allows for a write into the heap.", "evidenceUrl": ["https://github.blog/security/vulnerability-research/chrome-in-the-wild-bug-analysis-cve-2021-37975/"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1203/", "@type": "AttackTechnique", "techniqueId": "T1203", "name": "Exploitation for Client Execution", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0002/", "@type": "AttackTactic", "tacticId": "TA0002", "shortname": "execution"}]}}, {"@id": "urn:threatgraph:pkev-mapping:16", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "use_after_free", "comments": "CVE-2021-37975 allows an adversary to use JavaScript to exploit the Chromium browser V8 JavaScript engine which allows for a write into the heap.", "evidenceUrl": ["https://github.blog/security/vulnerability-research/chrome-in-the-wild-bug-analysis-cve-2021-37975/"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1059/007/", "@type": "AttackTechnique", "techniqueId": "T1059.007", "name": "JavaScript", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0002/", "@type": "AttackTactic", "tacticId": "TA0002", "shortname": "execution"}]}}], "wasDerivedFrom": ["https://github.com/cisagov/kev-data/tree/0cca62ed469c333a45760beeaf35fcc53352aedd"]}, {"@context": {"tg": "https://example.org/threatgraph/vocab#", "dcterms": "http://purl.org/dc/terms/", "dcat": "http://www.w3.org/ns/dcat#", "prov": "http://www.w3.org/ns/prov#", "rdfs": "http://www.w3.org/2000/01/rdf-schema#", "xsd": "http://www.w3.org/2001/XMLSchema#", "Vulnerability": "tg:Vulnerability", "NvdRecord": "tg:NvdRecord", "CvssV31": "tg:CvssV31", "Weakness": "tg:Weakness", "WeaknessAssignment": "tg:WeaknessAssignment", "AttackTechnique": "tg:AttackTechnique", "AttackTactic": "tg:AttackTactic", "Mapping": "tg:Mapping", "Dataset": "dcat:Dataset", "Distribution": "dcat:Distribution", "apiUrl": {"@id": "tg:apiUrl", "@type": "@id"}, "wasDerivedFrom": {"@id": "prov:wasDerivedFrom", "@type": "@id", "@container": "@set"}, "name": "rdfs:label", "description": "dcterms:description", "title": "dcterms:title", "cveId": "dcterms:identifier", "vendorProject": "tg:vendorProject", "product": "tg:product", "shortDescription": "tg:shortDescription", "requiredAction": "tg:requiredAction", "dateAdded": {"@id": "tg:dateAdded", "@type": "xsd:date"}, "dueDate": {"@id": "tg:dueDate", "@type": "xsd:date"}, "ransomwareUse": "tg:ransomwareUse", "notes": "tg:notes", "dueBeforeAdded": "tg:dueBeforeAdded", "weakness": {"@id": "tg:weakness", "@container": "@set"}, "nvd": "tg:nvdRecord", "mappings": {"@id": "tg:hasMapping", "@container": "@set"}, "cweId": "tg:cweId", "isInformative": "tg:isInformative", "vulnStatus": "tg:vulnStatus", "published": {"@id": "dcterms:issued", "@type": "xsd:dateTime"}, "nReferences": "tg:nReferences", "cvssV31": "tg:cvssV31", "cvssV2Score": {"@id": "tg:cvssV2Score", "@type": "xsd:decimal"}, "score": {"@id": "tg:baseScore", "@type": "xsd:decimal"}, "severity": "tg:severity", "vector": "tg:vector", "metricSource": "tg:metricSource", "metricType": "tg:metricType", "weaknessAssignment": {"@id": "tg:weaknessAssignment", "@container": "@set"}, "assignedBy": "tg:assignedBy", "assignmentType": "tg:assignmentType", "techniqueId": "tg:techniqueId", "tacticId": "tg:tacticId", "shortname": "tg:shortname", "status": "tg:status", "isSubtechnique": "tg:isSubtechnique", "created": {"@id": "dcterms:created", "@type": "xsd:dateTime"}, "modified": {"@id": "dcterms:modified", "@type": "xsd:dateTime"}, "parentTechnique": {"@id": "tg:parentTechnique", "@type": "@id"}, "subtechnique": {"@id": "tg:subtechnique", "@type": "@id", "@container": "@set"}, "tactic": {"@id": "tg:tactic", "@container": "@set"}, "technique": "tg:technique", "vulnerability": "tg:vulnerability", "mappingType": "tg:mappingType", "capabilityGroup": "tg:capabilityGroup", "comments": "tg:comments", "evidence": {"@id": "tg:evidence", "@container": "@set"}, "evidenceUrl": {"@id": "tg:evidenceUrl", "@type": "@id", "@container": "@set"}, "version": "dcterms:hasVersion", "publisher": "dcterms:publisher", "rights": "dcterms:rights", "sha256": "tg:sha256", "contentId": "tg:contentId", "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"}, "rawManifestSha256": "tg:rawManifestSha256", "cleaningCodeSha256": "tg:cleaningCodeSha256", "rowCount": "tg:rowCount", "distribution": {"@id": "dcat:distribution", "@container": "@set"}, "accessURL": {"@id": "dcat:accessURL", "@type": "@id"}, "mediaType": {"@id": "dcat:mediaType", "@container": "@set"}, "tables": "tg:tables", "totalItems": "tg:totalItems", "nextPage": {"@id": "tg:nextPage", "@type": "@id"}, "previousPage": {"@id": "tg:previousPage", "@type": "@id"}}, "@id": "https://nvd.nist.gov/vuln/detail/CVE-2021-39226", "@type": "Vulnerability", "cveId": "CVE-2021-39226", "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2021-39226/", "vendorProject": "Grafana Labs", "product": "Grafana", "title": "Grafana Authentication Bypass Vulnerability", "dateAdded": "2022-08-25", "dueDate": "2022-09-15", "shortDescription": "Grafana contains an authentication bypass vulnerability that allows authenticated and unauthenticated users to view and delete all snapshot data, potentially resulting in complete snapshot data loss.", "requiredAction": "Apply updates per vendor instructions.", "ransomwareUse": "unknown", "notes": "https://grafana.com/blog/2021/10/05/grafana-7.5.11-and-8.1.6-released-with-critical-security-fix/; https://nvd.nist.gov/vuln/detail/CVE-2021-39226", "dueBeforeAdded": false, "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/287.html", "@type": "Weakness", "cweId": "CWE-287", "isInformative": true}], "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2021-10-05T18:15:07.947000Z", "modified": "2025-02-18T14:53:42.247000Z", "description": "Grafana is an open source data visualization platform. In affected versions unauthenticated and authenticated users are able to view the snapshot with the lowest database key by accessing the literal paths: /dashboard/snapshot/:key, or /api/snapshots/:key. If the snapshot \"public_mode\" configuration setting is set to true (vs default of false), unauthenticated users are able to delete the snapshot with the lowest database key by accessing the literal path: /api/snapshots-delete/:deleteKey. Regardless of the snapshot \"public_mode\" setting, authenticated users are able to delete the snapshot with the lowest database key by accessing the literal paths: /api/snapshots/:key, or /api/snapshots-delete/:deleteKey. The combination of deletion and viewing enables a complete walk through all snapshot data while resulting in complete snapshot data loss. This issue has been resolved in versions 8.1.6 and 7.5.11. If for some reason you cannot upgrade you can use a reverse proxy or similar to block access to the literal paths: /api/snapshots/:key, /api/snapshots-delete/:deleteKey, /dashboard/snapshot/:key, and /api/snapshots/:key. They have no normal function and can be disabled without side effects.", "cvssV31": {"@type": "CvssV31", "score": 7.3, "severity": "HIGH", "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:L", "metricSource": "nvd@nist.gov", "metricType": "Primary"}, "cvssV2Score": 6.8, "nReferences": 16, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/287.html", "@type": "Weakness", "cweId": "CWE-287", "isInformative": true}], "assignedBy": "security-advisories@github.com", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/862.html", "@type": "Weakness", "cweId": "CWE-862", "isInformative": true}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:882", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "auth_bypass", "comments": "This authentication bypass vulnerability is exploited by both unauthenticated and authenticated adversaries via the snapshot feature in Grafana. Attackers have leveraged this vulnerability to access and manipulate snapshot data, potentially leading to unauthorized data exposure and loss. Exploitation techniques have not been publicly published. \n\nIn exploitation scenarios, adversaries can view snapshots with the lowest database key by accessing specific paths, such as /dashboard/snapshot/:key or /api/snapshots/:key. If the \"public_mode\" configuration is set to true, unauthenticated users can also delete these snapshots using the path /api/snapshots-delete/:deleteKey. This capability allows attackers to enumerate and delete snapshot data, resulting in complete data loss.", "evidence": ["that%20were%20listed%20in%20error.", "well%20as%20through%20Cortex%20XDR.&text=Updated%20Sept."], "evidenceUrl": ["https://grafana.com/blog/2021/10/05/grafana-7.5.11-and-8.1.6-released-with-critical-security-fix/", "https://unit42.paloaltonetworks.com/recent-exploits-network-security-trends/#:~:text=Additionally%2C%20we%20provide%20insight%20into"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1190/", "@type": "AttackTechnique", "techniqueId": "T1190", "name": "Exploit Public-Facing Application", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0001/", "@type": "AttackTactic", "tacticId": "TA0001", "shortname": "initial-access"}]}}, {"@id": "urn:threatgraph:pkev-mapping:883", "@type": "Mapping", "mappingType": "primary_impact", "capabilityGroup": "auth_bypass", "comments": "This authentication bypass vulnerability is exploited by both unauthenticated and authenticated adversaries via the snapshot feature in Grafana. Attackers have leveraged this vulnerability to access and manipulate snapshot data, potentially leading to unauthorized data exposure and loss. Exploitation techniques have not been publicly published. \n\nIn exploitation scenarios, adversaries can view snapshots with the lowest database key by accessing specific paths, such as /dashboard/snapshot/:key or /api/snapshots/:key. If the \"public_mode\" configuration is set to true, unauthenticated users can also delete these snapshots using the path /api/snapshots-delete/:deleteKey. This capability allows attackers to enumerate and delete snapshot data, resulting in complete data loss.", "evidence": ["that%20were%20listed%20in%20error.", "well%20as%20through%20Cortex%20XDR.&text=Updated%20Sept."], "evidenceUrl": ["https://grafana.com/blog/2021/10/05/grafana-7.5.11-and-8.1.6-released-with-critical-security-fix/", "https://unit42.paloaltonetworks.com/recent-exploits-network-security-trends/#:~:text=Additionally%2C%20we%20provide%20insight%20into"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1485/", "@type": "AttackTechnique", "techniqueId": "T1485", "name": "Data Destruction", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0040/", "@type": "AttackTactic", "tacticId": "TA0040", "shortname": "impact"}]}}], "wasDerivedFrom": ["https://github.com/cisagov/kev-data/tree/0cca62ed469c333a45760beeaf35fcc53352aedd"]}, {"@context": {"tg": "https://example.org/threatgraph/vocab#", "dcterms": "http://purl.org/dc/terms/", "dcat": "http://www.w3.org/ns/dcat#", "prov": "http://www.w3.org/ns/prov#", "rdfs": "http://www.w3.org/2000/01/rdf-schema#", "xsd": "http://www.w3.org/2001/XMLSchema#", "Vulnerability": "tg:Vulnerability", "NvdRecord": "tg:NvdRecord", "CvssV31": "tg:CvssV31", "Weakness": "tg:Weakness", "WeaknessAssignment": "tg:WeaknessAssignment", "AttackTechnique": "tg:AttackTechnique", "AttackTactic": "tg:AttackTactic", "Mapping": "tg:Mapping", "Dataset": "dcat:Dataset", "Distribution": "dcat:Distribution", "apiUrl": {"@id": "tg:apiUrl", "@type": "@id"}, "wasDerivedFrom": {"@id": "prov:wasDerivedFrom", "@type": "@id", "@container": "@set"}, "name": "rdfs:label", "description": "dcterms:description", "title": "dcterms:title", "cveId": "dcterms:identifier", "vendorProject": "tg:vendorProject", "product": "tg:product", "shortDescription": "tg:shortDescription", "requiredAction": "tg:requiredAction", "dateAdded": {"@id": "tg:dateAdded", "@type": "xsd:date"}, "dueDate": {"@id": "tg:dueDate", "@type": "xsd:date"}, "ransomwareUse": "tg:ransomwareUse", "notes": "tg:notes", "dueBeforeAdded": "tg:dueBeforeAdded", "weakness": {"@id": "tg:weakness", "@container": "@set"}, "nvd": "tg:nvdRecord", "mappings": {"@id": "tg:hasMapping", "@container": "@set"}, "cweId": "tg:cweId", "isInformative": "tg:isInformative", "vulnStatus": "tg:vulnStatus", "published": {"@id": "dcterms:issued", "@type": "xsd:dateTime"}, "nReferences": "tg:nReferences", "cvssV31": "tg:cvssV31", "cvssV2Score": {"@id": "tg:cvssV2Score", "@type": "xsd:decimal"}, "score": {"@id": "tg:baseScore", "@type": "xsd:decimal"}, "severity": "tg:severity", "vector": "tg:vector", "metricSource": "tg:metricSource", "metricType": "tg:metricType", "weaknessAssignment": {"@id": "tg:weaknessAssignment", "@container": "@set"}, "assignedBy": "tg:assignedBy", "assignmentType": "tg:assignmentType", "techniqueId": "tg:techniqueId", "tacticId": "tg:tacticId", "shortname": "tg:shortname", "status": "tg:status", "isSubtechnique": "tg:isSubtechnique", "created": {"@id": "dcterms:created", "@type": "xsd:dateTime"}, "modified": {"@id": "dcterms:modified", "@type": "xsd:dateTime"}, "parentTechnique": {"@id": "tg:parentTechnique", "@type": "@id"}, "subtechnique": {"@id": "tg:subtechnique", "@type": "@id", "@container": "@set"}, "tactic": {"@id": "tg:tactic", "@container": "@set"}, "technique": "tg:technique", "vulnerability": "tg:vulnerability", "mappingType": "tg:mappingType", "capabilityGroup": "tg:capabilityGroup", "comments": "tg:comments", "evidence": {"@id": "tg:evidence", "@container": "@set"}, "evidenceUrl": {"@id": "tg:evidenceUrl", "@type": "@id", "@container": "@set"}, "version": "dcterms:hasVersion", "publisher": "dcterms:publisher", "rights": "dcterms:rights", "sha256": "tg:sha256", "contentId": "tg:contentId", "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"}, "rawManifestSha256": "tg:rawManifestSha256", "cleaningCodeSha256": "tg:cleaningCodeSha256", "rowCount": "tg:rowCount", "distribution": {"@id": "dcat:distribution", "@container": "@set"}, "accessURL": {"@id": "dcat:accessURL", "@type": "@id"}, "mediaType": {"@id": "dcat:mediaType", "@container": "@set"}, "tables": "tg:tables", "totalItems": "tg:totalItems", "nextPage": {"@id": "tg:nextPage", "@type": "@id"}, "previousPage": {"@id": "tg:previousPage", "@type": "@id"}}, "@id": "https://nvd.nist.gov/vuln/detail/CVE-2022-47966", "@type": "Vulnerability", "cveId": "CVE-2022-47966", "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2022-47966/", "vendorProject": "Zoho", "product": "ManageEngine", "title": "Zoho ManageEngine Multiple Products Remote Code Execution Vulnerability", "dateAdded": "2023-01-23", "dueDate": "2023-02-13", "shortDescription": "Multiple Zoho ManageEngine products contain an unauthenticated remote code execution vulnerability due to the usage of an outdated third-party dependency, Apache Santuario.", "requiredAction": "Apply updates per vendor instructions.", "ransomwareUse": "known", "notes": "https://www.manageengine.com/security/advisory/CVE/cve-2022-47966.html;  https://nvd.nist.gov/vuln/detail/CVE-2022-47966", "dueBeforeAdded": false, "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2023-01-18T18:15:10.570000Z", "modified": "2025-03-07T21:04:52.037000Z", "description": "Multiple Zoho ManageEngine on-premise products, such as ServiceDesk Plus through 14003, allow remote code execution due to use of Apache Santuario xmlsec (aka XML Security for Java) 1.4.1, because the xmlsec XSLT features, by design in that version, make the application responsible for certain security protections, and the ManageEngine applications did not provide those protections. This affects Access Manager Plus before 4308, Active Directory 360 before 4310, ADAudit Plus before 7081, ADManager Plus before 7162, ADSelfService Plus before 6211, Analytics Plus before 5150, Application Control Plus before 10.1.2220.18, Asset Explorer before 6983, Browser Security Plus before 11.1.2238.6, Device Control Plus before 10.1.2220.18, Endpoint Central before 10.1.2228.11, Endpoint Central MSP before 10.1.2228.11, Endpoint DLP before 10.1.2137.6, Key Manager Plus before 6401, OS Deployer before 1.1.2243.1, PAM 360 before 5713, Password Manager Pro before 12124, Patch Manager Plus before 10.1.2220.18, Remote Access Plus before 10.1.2228.11, Remote Monitoring and Management (RMM) before 10.1.41. ServiceDesk Plus before 14004, ServiceDesk Plus MSP before 13001, SupportCenter Plus before 11026, and Vulnerability Manager Plus before 10.1.2220.18. Exploitation is only possible if SAML SSO has ever been configured for a product (for some products, exploitation requires that SAML SSO is currently active).", "cvssV31": {"@type": "CvssV31", "score": 9.8, "severity": "CRITICAL", "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "metricSource": "nvd@nist.gov", "metricType": "Primary"}, "nReferences": 20, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/20.html", "@type": "Weakness", "cweId": "CWE-20", "isInformative": true}], "assignedBy": "134c704f-9b21-4f2e-91b3-4a467353bcc0", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "urn:threatgraph:weakness:NVD-CWE-noinfo", "@type": "Weakness", "cweId": "NVD-CWE-noinfo", "isInformative": false}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:569", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "code_execution", "comments": "CVE-2022-47966 is a remote code execution vulnerability that affects many ManageEngine products due to misconfiguration of security features. Adversaries can utilized this vulnerability to run arbitrary java. APTs have been observed exploiting this vulnerability to gain access, to public-facing applications, establish persistence, and move laterally.\n\nThey've also been observed to create local user accounts with administrative privileges, use valid but disabled user accounts, delete logs, establish command and control communications, ... **the list goes on and on due to fantastic, detailed reporting**", "evidenceUrl": ["https://github.com/horizon3ai/CVE-2022-47966", "https://www.cisa.gov/news-events/cybersecurity-advisories/aa23-250a", "https://www.cisa.gov/sites/default/files/2023-09/aa23-250a-apt-actors-exploit-cve-2022-47966-and-cve-2022-42475_1.pdf"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1190/", "@type": "AttackTechnique", "techniqueId": "T1190", "name": "Exploit Public-Facing Application", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0001/", "@type": "AttackTactic", "tacticId": "TA0001", "shortname": "initial-access"}]}}, {"@id": "urn:threatgraph:pkev-mapping:570", "@type": "Mapping", "mappingType": "primary_impact", "capabilityGroup": "code_execution", "comments": "CVE-2022-47966 is a remote code execution vulnerability that affects many ManageEngine products due to misconfiguration of security features. Adversaries can utilized this vulnerability to run arbitrary java. APTs have been observed exploiting this vulnerability to gain access, to public-facing applications, establish persistence, and move laterally.\n\nThey've also been observed to create local user accounts with administrative privileges, use valid but disabled user accounts, delete logs, establish command and control communications, ... **the list goes on and on due to fantastic, detailed reporting**", "evidenceUrl": ["https://github.com/horizon3ai/CVE-2022-47966", "https://www.cisa.gov/news-events/cybersecurity-advisories/aa23-250a", "https://www.cisa.gov/sites/default/files/2023-09/aa23-250a-apt-actors-exploit-cve-2022-47966-and-cve-2022-42475_1.pdf"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1136/001/", "@type": "AttackTechnique", "techniqueId": "T1136.001", "name": "Local Account", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0003/", "@type": "AttackTactic", "tacticId": "TA0003", "shortname": "persistence"}]}}, {"@id": "urn:threatgraph:pkev-mapping:571", "@type": "Mapping", "mappingType": "primary_impact", "capabilityGroup": "code_execution", "comments": "CVE-2022-47966 is a remote code execution vulnerability that affects many ManageEngine products due to misconfiguration of security features. Adversaries can utilized this vulnerability to run arbitrary java. APTs have been observed exploiting this vulnerability to gain access, to public-facing applications, establish persistence, and move laterally.\n\nThey've also been observed to create local user accounts with administrative privileges, use valid but disabled user accounts, delete logs, establish command and control communications, ... **the list goes on and on due to fantastic, detailed reporting**", "evidenceUrl": ["https://github.com/horizon3ai/CVE-2022-47966", "https://www.cisa.gov/news-events/cybersecurity-advisories/aa23-250a", "https://www.cisa.gov/sites/default/files/2023-09/aa23-250a-apt-actors-exploit-cve-2022-47966-and-cve-2022-42475_1.