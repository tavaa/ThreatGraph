ity", "cvssV31": {"@type": "CvssV31", "score": 7.8, "severity": "HIGH", "vector": "CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H", "metricSource": "secure@microsoft.com", "metricType": "Primary"}, "nReferences": 2, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/269.html", "@type": "Weakness", "cweId": "CWE-269", "isInformative": true}], "assignedBy": "secure@microsoft.com", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "urn:threatgraph:weakness:NVD-CWE-noinfo", "@type": "Weakness", "cweId": "NVD-CWE-noinfo", "isInformative": false}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:346", "@type": "Mapping", "mappingType": "primary_impact", "capabilityGroup": "priv_mgmt", "comments": "This vulnerability is a zero-day exploit that \"manipulates the Windows file werkernel.sys, which uses a null security descriptor when creating registry keys. Attackers create a registry key HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\WerFault.exe and set the \"Debugger\" value to the exploit's executable pathname. This allows the exploit to start a shell with administrative privileges.\" This vulnerability has been exploited by the Black Basta ransomware group.", "evidenceUrl": ["https://www.rescana.com/post/cve-2024-26169-active-exploitation-of-windows-elevation-of-privilege-flaw"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1059/", "@type": "AttackTechnique", "techniqueId": "T1059", "name": "Command and Scripting Interpreter", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0002/", "@type": "AttackTactic", "tacticId": "TA0002", "shortname": "execution"}]}}, {"@id": "urn:threatgraph:pkev-mapping:347", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "priv_mgmt", "comments": "This vulnerability is a zero-day exploit that \"manipulates the Windows file werkernel.sys, which uses a null security descriptor when creating registry keys. Attackers create a registry key HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\WerFault.exe and set the \"Debugger\" value to the exploit's executable pathname. This allows the exploit to start a shell with administrative privileges.\" This vulnerability has been exploited by the Black Basta ransomware group.", "evidenceUrl": ["https://www.rescana.com/post/cve-2024-26169-active-exploitation-of-windows-elevation-of-privilege-flaw"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1203/", "@type": "AttackTechnique", "techniqueId": "T1203", "name": "Exploitation for Client Execution", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0002/", "@type": "AttackTactic", "tacticId": "TA0002", "shortname": "execution"}]}}, {"@id": "urn:threatgraph:pkev-mapping:348", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "priv_mgmt", "comments": "This vulnerability is a zero-day exploit that \"manipulates the Windows file werkernel.sys, which uses a null security descriptor when creating registry keys. Attackers create a registry key HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\WerFault.exe and set the \"Debugger\" value to the exploit's executable pathname. This allows the exploit to start a shell with administrative privileges.\" This vulnerability has been exploited by the Black Basta ransomware group.", "evidenceUrl": ["https://www.rescana.com/post/cve-202