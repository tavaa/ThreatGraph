s/39.html", "@type": "Weakness", "cweId": "CWE-39", "isInformative": true}], "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2021-03-03T00:15:12.307000Z", "modified": "2025-03-07T21:59:37.343000Z", "description": "Microsoft Exchange Server Remote Code Execution Vulnerability", "cvssV31": {"@type": "CvssV31", "score": 7.8, "severity": "HIGH", "vector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H", "metricSource": "secure@microsoft.com", "metricType": "Secondary"}, "cvssV2Score": 6.8, "nReferences": 6, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/22.html", "@type": "Weakness", "cweId": "CWE-22", "isInformative": true}], "assignedBy": "134c704f-9b21-4f2e-91b3-4a467353bcc0", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/22.html", "@type": "Weakness", "cweId": "CWE-22", "isInformative": true}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:657", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "code_execution", "comments": "CVE-2021-26858, part of Proxy Logon, is a post-authentication arbitrary file write vulnerability in Exchange. CVE-2021-26858 and CVE-2021-27065 are similar post-authentication arbitrary write file vulnerabilities in Exchange. An attacker, authenticated either by using CVE-2021-26855 or via stolen admin credentials, could write a file to any path on the server.", "evidenceUrl": ["https://www.microsoft.com/en-us/security/blog/2021/03/02/hafnium-targeting-exchange-servers/"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T