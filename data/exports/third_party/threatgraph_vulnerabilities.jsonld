nReferences", "cvssV31": "tg:cvssV31", "cvssV2Score": {"@id": "tg:cvssV2Score", "@type": "xsd:decimal"}, "score": {"@id": "tg:baseScore", "@type": "xsd:decimal"}, "severity": "tg:severity", "vector": "tg:vector", "metricSource": "tg:metricSource", "metricType": "tg:metricType", "weaknessAssignment": {"@id": "tg:weaknessAssignment", "@container": "@set"}, "assignedBy": "tg:assignedBy", "assignmentType": "tg:assignmentType", "techniqueId": "tg:techniqueId", "tacticId": "tg:tacticId", "shortname": "tg:shortname", "status": "tg:status", "isSubtechnique": "tg:isSubtechnique", "created": {"@id": "dcterms:created", "@type": "xsd:dateTime"}, "modified": {"@id": "dcterms:modified", "@type": "xsd:dateTime"}, "parentTechnique": {"@id": "tg:parentTechnique", "@type": "@id"}, "subtechnique": {"@id": "tg:subtechnique", "@type": "@id", "@container": "@set"}, "tactic": {"@id": "tg:tactic", "@container": "@set"}, "technique": "tg:technique", "vulnerability": "tg:vulnerability", "mappingType": "tg:mappingType", "capabilityGroup": "tg:capabilityGroup", "comments": "tg:comments", "evidence": {"@id": "tg:evidence", "@container": "@set"}, "evidenceUrl": {"@id": "tg:evidenceUrl", "@type": "@id", "@container": "@set"}, "version": "dcterms:hasVersion", "publisher": "dcterms:publisher", "rights": "dcterms:rights", "sha256": "tg:sha256", "contentId": "tg:contentId", "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"}, "rawManifestSha256": "tg:rawManifestSha256", "cleaningCodeSha256": "tg:cleaningCodeSha256", "rowCount": "tg:rowCount", "distribution": {"@id": "dcat:distribution", "@container": "@set"}, "accessURL": {"@id": "dcat:accessURL", "@type": "@id"}, "mediaType": {"@id": "dcat:mediaType", "@container": "@set"}, "tables": "tg:tables", "totalItems": "tg:totalItems", "nextPage": {"@id": "tg:nextPage", "@type": "@id"}, "previousPage": {"@id": "tg:previousPage", "@type": "@id"}}, "@id": "https://nvd.nist.gov/vuln/detail/CVE-2023-36845", "@type": "Vulnerability", "cveId": "CVE-2023-36845", "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2023-36845/", "vendorProject": "Juniper", "product": "Junos OS", "title": "Juniper Junos OS EX Series and SRX Series PHP External Variable Modification Vulnerability", "dateAdded": "2023-11-13", "dueDate": "2023-11-17", "shortDescription": "Juniper Junos OS on EX Series and SRX Series contains a PHP external variable modification vulnerability that allows an unauthenticated, network-based attacker to control an important environment variable. Using a crafted request, which sets the variable PHPRC, an attacker is able to modify the PHP execution environment allowing the injection und execution of code.", "requiredAction": "Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.", "ransomwareUse": "unknown", "notes": "https://supportportal.juniper.net/s/article/2023-08-Out-of-Cycle-Security-Bulletin-Junos-OS-SRX-Series-and-EX-Series-Multiple-vulnerabilities-in-J-Web-can-be-combined-to-allow-a-preAuth-Remote-Code-Execution?language=en_US ;  https://nvd.nist.gov/vuln/detail/CVE-2023-36845", "dueBeforeAdded": false, "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/473.html", "@type": "Weakness", "cweId": "CWE-473", "isInformative": true}], "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2023-08-17T20:15:10.360000Z", "modified": "2025-03-10T20:31:09.807000Z", "description": "A PHP External Variable Modification vulnerability in J-Web of Juniper Networks Junos OS on EX Series \n\nand SRX Series \n\nallows an unauthenticated, network-based attacker to remotely execute code.\n\nUsing a crafted request which sets the variable PHPRC an attacker is able to modify the PHP execution environment allowing the injection und execution of code.\n\n\nThis issue affects Juniper Networks Junos OS on EX Series\n\n\nand \n\n\nSRX Series:\n\n\n\n  *  All versions prior to \n\n20.4R3-S9;\n  *  21.1 versions 21.1R1 and later;\n  *  21.2 versions prior to\u00a021.2R3-S7;\n  *  21.3 versions prior to\u00a021.3R3-S5;\n  *  21.4 versions prior to 21.4R3-S5;\n  *  22.1 versions \n\nprior to \n\n22.1R3-S4;\n  *  22.2 versions \n\nprior to \n\n22.2R3-S2;\n  *  22.3 versions \n\nprior to \n\n22.3R2-S2, 22.3R3-S1;\n  *  22.4 versions \n\nprior to \n\n22.4R2-S1, 22.4R3;\n  *  23.2 versions prior to 23.2R1-S1, 23.2R2.", "cvssV31": {"@type": "CvssV31", "score": 9.8, "severity": "CRITICAL", "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "metricSource": "sirt@juniper.net", "metricType": "Primary"}, "nReferences": 6, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/473.html", "@type": "Weakness", "cweId": "CWE-473", "isInformative": true}], "assignedBy": "sirt@juniper.net", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "urn:threatgraph:weakness:NVD-CWE-Other", "@type": "Weakness", "cweId": "NVD-CWE-Other", "isInformative": false}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:270", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "other", "comments": "This vulnerability is exploited through a PHP External Variable Modification flaw in the J-Web interface of Juniper Networks Junos OS, affecting EX Series switches and SRX Series firewalls. Attackers leverage this vulnerability to gain initial access by crafting a request that sets the PHPRC variable, thereby altering the PHP execution environment. This manipulation enables the injection and execution of arbitrary code. By exploiting the auto_prepend_file and allow_url_include PHP features, attackers can include a base64 encoded PHP payload using the data:// wrapper. This method allows them to execute code within a confined FreeBSD jail environment, with the potential to escalate privileges by stealing authentication tokens from a user logged into the J-Web application, ultimately enabling unauthorized SSH access with elevated privileges.", "evidenceUrl": ["https://packetstormsecurity.com/files/174865/Juniper-SRX-Firewall-EX-Switch-Remote-Code-Execution.html", "https://www.bleepingcomputer.com/news/security/cisa-warns-of-actively-exploited-juniper-pre-auth-rce-exploit-chain/", "https://www.greenbone.net/en/blog/tracking-news-juniper-junos-vulnerabilities/"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1190/", "@type": "AttackTechnique", "techniqueId": "T1190", "name": "Exploit Public-Facing Application", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0001/", "@type": "AttackTactic", "tacticId": "TA0001", "shortname": "initial-access"}]}}, {"@id": "urn:threatgraph:pkev-mapping:271", "@type": "Mapping", "mappingType": "primary_impact", "capabilityGroup": "other", "comments": "This vulnerability is exploited through a PHP External Variable Modification flaw in the J-Web interface of Juniper Networks Junos OS, affecting EX Series switches and SRX Series firewalls. Attackers leverage this vulnerability to gain initial access by crafting a request that sets the PHPRC variable, thereby altering the PHP execution environment. This manipulation enables the injection and execution of arbitrary code. By exploiting the auto_prepend_file and allow_url_include PHP features, attackers can include a base64 encoded PHP payload using the data:// wrapper. This method allows them to execute code within a confined FreeBSD jail environment, with the potential to escalate privileges by stealing authentication tokens from a user logged into the J-Web application, ultimately enabling unauthorized SSH access with elevated privileges.", "evidenceUrl": ["https://packetstor