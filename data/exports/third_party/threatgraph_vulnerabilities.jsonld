.gov/vuln/detail/CVE-2025-25257", "@type": "Vulnerability", "cveId": "CVE-2025-25257", "apiUrl": "http://127.0.0.1:8000/api/vulnerabilities/CVE-2025-25257/", "vendorProject": "Fortinet", "product": "FortiWeb", "title": "Fortinet FortiWeb SQL Injection Vulnerability", "dateAdded": "2025-07-18", "dueDate": "2025-08-08", "shortDescription": "Fortinet FortiWeb contains a SQL injection vulnerability that may allow an unauthenticated attacker to execute unauthorized SQL code or commands via crafted HTTP or HTTPs requests.", "requiredAction": "Apply mitigations per vendor instructions, follow applicable BOD 22-01 guidance for cloud services, or discontinue use of the product if mitigations are unavailable.", "ransomwareUse": "unknown", "notes": "https://fortiguard.fortinet.com/psirt/FG-IR-25-151 ; https://nvd.nist.gov/vuln/detail/CVE-2025-25257", "dueBeforeAdded": false, "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/89.html", "@type": "Weakness", "cweId": "CWE-89", "isInformative": true}], "nvd": {"@type": "NvdRecord", "vulnStatus": "Analyzed", "published": "2025-07-17T16:15:34.723000Z", "modified": "2025-07-21T15:01:21.393000Z", "description": "An improper neutralization of special elements used in an SQL command ('SQL Injection') vulnerability [CWE-89] in Fortinet FortiWeb version 7.6.0 through 7.6.3, 7.4.0 through 7.4.7, 7.2.0 through 7.2.10 and below 7.0.10 allows an unauthenticated attacker to execute unauthorized SQL code or commands via crafted HTTP or HTTPs requests.", "cvssV31": {"@type": "CvssV31", "score": 9.8, "severity": "CRITICAL", "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "metricSource": "psirt@fortinet.com", "metricType": "Secondary"}, "nReferences": 2, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/89.html", "@type": "Weakness", "cweId": "CWE-89", "isInformative": true}], "assignedBy": "psirt@fortinet.com", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:113", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "sql_injection", "comments": "Affected versions of FortiWeb contain insufficient input sanitization, allowing for an attacker to use SQL injection to write a malicious .pth file to the into FortiWeb's site-packages Python directory. This allows the malicious code to execute using the privileges granted to Python scripts in that high-level directory.", "evidenceUrl": ["https://zeropath.com/blog/fortinet-fortiweb-cve-2025-25257-sql-injection-rce"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1055/", "@type": "AttackTechnique", "techniqueId": "T1055", "name": "Process Injection", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0004/", "@type": "AttackTactic", "tacticId": "TA0004", "shortname": "privilege-escalation"}, {"@id": "https://attack.mitre.org/tactics/TA0005/", "@type": "AttackTactic", "tacticId": "TA0005", "shortname": "defense-evasion"}]}}, {"@id": "urn:threatgraph:pkev-mapping:114", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "sql_injection", "comments": "Affected versions of FortiWeb contain insufficient input sanitization, allowing for an attacker to use SQL injection to write a malicious .pth file to the into FortiWeb's site-packages Python directory. This allows the malicious code to execute using the privileges granted to Python scripts in that high-level directory.", "evidenceUrl": ["https://zeropath.com/blog/fortinet-fortiweb-cve-2025-25257-sql-injection-rce"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "http