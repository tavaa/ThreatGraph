nvd": {"@type": "NvdRecord", "vulnStatus": "Deferred", "published": "2017-03-11T02:59:00.150000Z", "modified": "2025-04-20T01:37:25.860000Z", "description": "The Jakarta Multipart parser in Apache Struts 2 2.3.x before 2.3.32 and 2.5.x before 2.5.10.1 has incorrect exception handling and error-message generation during file-upload attempts, which allows remote attackers to execute arbitrary commands via a crafted Content-Type, Content-Disposition, or Content-Length HTTP header, as exploited in the wild in March 2017 with a Content-Type header containing a #cmd= string.", "cvssV31": {"@type": "CvssV31", "score": 9.8, "severity": "CRITICAL", "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H", "metricSource": "nvd@nist.gov", "metricType": "Primary"}, "cvssV2Score": 10.0, "nReferences": 66, "weaknessAssignment": [{"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/755.html", "@type": "Weakness", "cweId": "CWE-755", "isInformative": true}], "assignedBy": "134c704f-9b21-4f2e-91b3-4a467353bcc0", "assignmentType": "Secondary"}, {"@type": "WeaknessAssignment", "weakness": [{"@id": "https://cwe.mitre.org/data/definitions/755.html", "@type": "Weakness", "cweId": "CWE-755", "isInformative": true}], "assignedBy": "nvd@nist.gov", "assignmentType": "Primary"}], "wasDerivedFrom": ["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]}, "mappings": [{"@id": "urn:threatgraph:pkev-mapping:733", "@type": "Mapping", "mappingType": "exploitation_technique", "capabilityGroup": "code_execution", "comments": "CVE-2017-5638  is a remote code execution vulnerability in Apache Struts Jakarta Multipart versions that allows for malicious file upload using Content-Type, Content-Disposition, or Content-Length HTTP headers during file-upload attempts leading to an attacker to execute arbitrary commands. This CVE was known to be exploited during the Equifax breach.", "evidenceUrl": ["https://securityaffairs.com/63043/hacking/equifax-data-breach.html", "https://www.synopsys.com/blogs/software-security/equifax-apache-struts-vulnerability-cve-2017-5638.html"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1190/", "@type": "AttackTechnique", "techniqueId": "T1190", "name": "Exploit Public-Facing Application", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0001/", "@type": "AttackTactic", "tacticId": "TA0001", "shortname": "initial-access"}]}}, {"@id": "urn:threatgraph:pkev-mapping:734", "@type": "Mapping", "mappingType": "primary_impact", "capabilityGroup": "code_execution", "comments": "CVE-2017-5638  is a remote code execution vulnerability in Apache Struts Jakarta Multipart versions that allows for malicious file upload using Content-Type, Content-Disposition, or Content-Length HTTP headers during file-upload attempts leading to an attacker to execute arbitrary commands. This CVE was known to be exploited during the Equifax breach.", "evidenceUrl": ["https://securityaffairs.com/63043/hacking/equifax-data-breach.html", "https://www.synopsys.com/blogs/software-security/equifax-apache-struts-vulnerability-cve-2017-5638.html"], "wasDerivedFrom": ["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"], "technique": {"@id": "https://attack.mitre.org/techniques/T1059/", "@type": "AttackTechnique", "techniqueId": "T1059", "name": "Command and Scripting Interpreter", "tactic": [{"@id": "https://attack.mitre.org/tactics/TA0002/", "@type": "AttackTactic", "tacticId": "TA0002", "shortname": "execution"}]}}, {"@id": "urn:threatgraph:pkev-mapping:735", "@type": "Mapping", "mappingType": "secondary_impact", "capabilityGroup": "code_execution", "comments": "CVE-2017-5638  is a remote code execution vulnerability in Apache Struts Jakarta Multipart versions that allo