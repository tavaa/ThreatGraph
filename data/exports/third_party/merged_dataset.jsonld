   {
    "@id": "urn:threatgraph:pkev-mapping:116",
    "@type": [
     "https://example.org/threatgraph/vocab#Mapping"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
     {
      "@id": "https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"
     }
    ],
    "https://example.org/threatgraph/vocab#capabilityGroup": [
     {
      "@value": "sql_injection"
     }
    ],
    "https://example.org/threatgraph/vocab#comments": [
     {
      "@value": "Affected versions of FortiWeb contain insufficient input sanitization, allowing for an attacker to use SQL injection to write a malicious .pth file to the into FortiWeb's site-packages Python directory. This allows the malicious code to execute using the privileges granted to Python scripts in that high-level directory. Given the use of SQL, this can lead to potential loss of data within the database."
     }
    ],
    "https://example.org/threatgraph/vocab#evidenceUrl": [
     {
      "@id": "https://zeropath.com/blog/fortinet-fortiweb-cve-2025-25257-sql-injection-rce"
     }
    ],
