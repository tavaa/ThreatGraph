     }
    ],
    "https://example.org/threatgraph/vocab#capabilityGroup": [
     {
      "@value": "buffer_overflow"
     }
    ],
    "https://example.org/threatgraph/vocab#comments": [
     {
      "@value": "This vulnerability, if exploited, would allow an adversary to obtain SYSTEM-level privileges, resulting in total system compromise."
