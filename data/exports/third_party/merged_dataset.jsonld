     {
      "@value": "Grafana contains an authentication bypass vulnerability that allows authenticated and unauthenticated users to view and delete all snapshot data, potentially resulting in complete snapshot data loss."
     }
    ],
    "https://example.org/threatgraph/vocab#vendorProject": [
     {
      "@value": "Grafana Labs"
     }
    ],
