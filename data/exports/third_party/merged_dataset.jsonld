     }
    ],
    "https://example.org/threatgraph/vocab#requiredAction": [
     {
      "@value": "Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable."
     }
    ],
    "https://example.org/threatgraph/vocab#shortDescription": [
     {
      "@value": "Juniper Junos OS on EX Series and SRX Series contains a PHP external variable modification vulnerability that allows an unauthenticated, network-based attacker to control an important environment variable. Using a crafted request, which sets the variable PHPRC, an attacker is able to modify the PHP execution environment allowing the injection und execution of code."
     }
    ],
    "https://example.org/threatgraph/vocab#vendorProject": [
