    "https://example.org/threatgraph/vocab#capabilityGroup": [
     {
      "@value": "auth_bypass"
     }
    ],
    "https://example.org/threatgraph/vocab#comments": [
     {
      "@value": "This authentication bypass vulnerability is exploited by both unauthenticated and authenticated adversaries via the snapshot feature in Grafana. Attackers have leveraged this vulnerability to access and manipulate snapshot data, potentially leading to unauthorized data exposure and loss. Exploitation techniques have not been publicly published. \n\nIn exploitation scenarios, adversaries can view snapshots with the lowest database key by accessing specific paths, such as /dashboard/snapshot/:key or /api/snapshots/:key. If the \"public_mode\" configuration is set to true, unauthenticated users can also delete these snapshots using the path /api/snapshots-delete/:deleteKey. This capability allows attackers to enumerate and delete snapshot data, resulting in complete data loss."
     }
    ],
    "https://example.org/threatgraph/vocab#evidence": [
     {
      "@value": "that%20were%20listed%20in%20error."
     },
     {
      "@value": "well%20as%20through%20Cortex%20XDR.&text=Updated%20Sept."
     }
    ],
