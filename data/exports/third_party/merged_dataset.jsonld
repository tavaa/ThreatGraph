    "https://example.org/threatgraph/vocab#notes": [
     {
      "@value": "https://supportportal.juniper.net/s/article/2023-08-Out-of-Cycle-Security-Bulletin-Junos-OS-SRX-Series-and-EX-Series-Multiple-vulnerabilities-in-J-Web-can-be-combined-to-allow-a-preAuth-Remote-Code-Execution?language=en_US ;  https://nvd.nist.gov/vuln/detail/CVE-2023-36845"
     }
    ],
    "https://example.org/threatgraph/vocab#nvdRecord": [
