{"@context":{"tg":"https://example.org/threatgraph/vocab#","dcterms":"http://purl.org/dc/terms/","dcat":"http://www.w3.org/ns/dcat#","prov":"http://www.w3.org/ns/prov#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","xsd":"http://www.w3.org/2001/XMLSchema#","Vulnerability":"tg:Vulnerability","NvdRecord":"tg:NvdRecord","CvssV31":"tg:CvssV31","Weakness":"tg:Weakness","WeaknessAssignment":"tg:WeaknessAssignment","AttackTechnique":"tg:AttackTechnique","AttackTactic":"tg:AttackTactic","Mapping":"tg:Mapping","Dataset":"dcat:Dataset","Distribution":"dcat:Distribution","apiUrl":{"@id":"tg:apiUrl","@type":"@id"},"wasDerivedFrom":{"@id":"prov:wasDerivedFrom","@type":"@id","@container":"@set"},"name":"rdfs:label","description":"dcterms:description","title":"dcterms:title","cveId":"dcterms:identifier","vendorProject":"tg:vendorProject","product":"tg:product","shortDescription":"tg:shortDescription","requiredAction":"tg:requiredAction","dateAdded":{"@id":"tg:dateAdded","@type":"xsd:date"},"dueDate":{"@id":"tg:dueDate","@type":"xsd:date"},"ransomwareUse":"tg:ransomwareUse","notes":"tg:notes","dueBeforeAdded":"tg:dueBeforeAdded","weakness":{"@id":"tg:weakness","@container":"@set"},"nvd":"tg:nvdRecord","mappings":{"@id":"tg:hasMapping","@container":"@set"},"cweId":"tg:cweId","isInformative":"tg:isInformative","vulnStatus":"tg:vulnStatus","published":{"@id":"dcterms:issued","@type":"xsd:dateTime"},"nReferences":"tg:nReferences","cvssV31":"tg:cvssV31","cvssV2Score":{"@id":"tg:cvssV2Score","@type":"xsd:decimal"},"score":{"@id":"tg:baseScore","@type":"xsd:decimal"},"severity":"tg:severity","vector":"tg:vector","metricSource":"tg:metricSource","metricType":"tg:metricType","weaknessAssignment":{"@id":"tg:weaknessAssignment","@container":"@set"},"assignedBy":"tg:assignedBy","assignmentType":"tg:assignmentType","techniqueId":"tg:techniqueId","tacticId":"tg:tacticId","shortname":"tg:shortname","status":"tg:status","isSubtechnique":"tg:isSubtechnique","created":{"@id":"dcterms:created","@type":"xsd:dateTime"},"modified":{"@id":"dcterms:modified","@type":"xsd:dateTime"},"parentTechnique":{"@id":"tg:parentTechnique","@type":"@id"},"subtechnique":{"@id":"tg:subtechnique","@type":"@id","@container":"@set"},"tactic":{"@id":"tg:tactic","@container":"@set"},"technique":"tg:technique","vulnerability":"tg:vulnerability","mappingType":"tg:mappingType","capabilityGroup":"tg:capabilityGroup","comments":"tg:comments","evidence":{"@id":"tg:evidence","@container":"@set"},"evidenceUrl":{"@id":"tg:evidenceUrl","@type":"@id","@container":"@set"},"version":"dcterms:hasVersion","publisher":"dcterms:publisher","rights":"dcterms:rights","sha256":"tg:sha256","contentId":"tg:contentId","wasRevisionOf":{"@id":"prov:wasRevisionOf","@type":"@id"},"rawManifestSha256":"tg:rawManifestSha256","cleaningCodeSha256":"tg:cleaningCodeSha256","rowCount":"tg:rowCount","distribution":{"@id":"dcat:distribution","@container":"@set"},"accessURL":{"@id":"dcat:accessURL","@type":"@id"},"mediaType":{"@id":"dcat:mediaType","@container":"@set"},"tables":"tg:tables","totalItems":"tg:totalItems","nextPage":{"@id":"tg:nextPage","@type":"@id"},"previousPage":{"@id":"tg:previousPage","@type":"@id"}},"@id":"https://nvd.nist.gov/vuln/detail/CVE-2021-44228","@type":"Vulnerability","cveId":"CVE-2021-44228","apiUrl":"http://127.0.0.1:8000/api/vulnerabilities/CVE-2021-44228/","vendorProject":"Apache","product":"Log4j2","title":"Apache Log4j2 Remote Code Execution Vulnerability","dateAdded":"2021-12-10","dueDate":"2021-12-24","shortDescription":"Apache Log4j2 contains a vulnerability where JNDI features do not protect against attacker-controlled JNDI-related endpoints, allowing for remote code execution.","requiredAction":"For all affected software assets for which updates exist, the only acceptable remediation actions are: 1) Apply updates; OR 2) remove affected assets from agency networks. Temporary mitigations using one of the measures provided at https://www.cisa.gov/uscert/ed-22-02-apache-log4j-recommended-mitigation-measures are only acceptable until updates are available.","ransomwareUse":"known","notes":"https://nvd.nist.gov/vuln/detail/CVE-2021-44228","dueBeforeAdded":false,"weakness":[{"@id":"https://cwe.mitre.org/data/definitions/20.html","@type":"Weakness","cweId":"CWE-20","isInformative":true},{"@id":"https://cwe.mitre.org/data/definitions/400.html","@type":"Weakness","cweId":"CWE-400","isInformative":true},{"@id":"https://cwe.mitre.org/data/definitions/502.html","@type":"Weakness","cweId":"CWE-502","isInformative":true}],"nvd":{"@type":"NvdRecord","vulnStatus":"Analyzed","published":"2021-12-10T10:15:09.143000Z","modified":"2025-04-03T20:53:22.977000Z","description":"Apache Log4j2 2.0-beta9 through 2.15.0 (excluding security releases 2.12.2, 2.12.3, and 2.3.1) JNDI features used in configuration, log messages, and parameters do not protect against attacker controlled LDAP and other JNDI related endpoints. An attacker who can control log messages or log message parameters can execute arbitrary code loaded from LDAP servers when message lookup substitution is enabled. From log4j 2.15.0, this behavior has been disabled by default. From version 2.16.0 (along with 2.12.2, 2.12.3, and 2.3.1), this functionality has been completely removed. Note that this vulnerability is specific to log4j-core and does not affect log4net, log4cxx, or other Apache Logging Services projects.","cvssV31":{"@type":"CvssV31","score":10.0,"severity":"CRITICAL","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H","metricSource":"nvd@nist.gov","metricType":"Primary"},"cvssV2Score":9.3,"nReferences":118,"weaknessAssignment":[{"@type":"WeaknessAssignment","weakness":[{"@id":"https://cwe.mitre.org/data/definitions/20.html","@type":"Weakness","cweId":"CWE-20","isInformative":true}],"assignedBy":"security@apache.org","assignmentType":"Primary"},{"@type":"WeaknessAssignment","weakness":[{"@id":"https://cwe.mitre.org/data/definitions/400.html","@type":"Weakness","cweId":"CWE-400","isInformative":true}],"assignedBy":"security@apache.org","assignmentType":"Primary"},{"@type":"WeaknessAssignment","weakness":[{"@id":"https://cwe.mitre.org/data/definitions/502.html","@type":"Weakness","cweId":"CWE-502","isInformative":true}],"assignedBy":"security@apache.org","assignmentType":"Primary"},{"@type":"WeaknessAssignment","weakness":[{"@id":"https://cwe.mitre.org/data/definitions/917.html","@type":"Weakness","cweId":"CWE-917","isInformative":true}],"assignedBy":"nvd@nist.gov","assignmentType":"Secondary"}],"wasDerivedFrom":["https://github.com/fkie-cad/nvd-json-data-feeds/tree/a4262227a26a698199ea8d287932f8639e85aa6d"]},"mappings":[{"@id":"urn:threatgraph:pkev-mapping:619","@type":"Mapping","mappingType":"exploitation_technique","capabilityGroup":"code_execution","comments":"This remote code execution vulnerability is exploited through maliciously-crafted requests to a web application.","evidenceUrl":["https://unit42.paloaltonetworks.com/apache-log4j-vulnerability-cve-2021-44228/"],"wasDerivedFrom":["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"],"technique":{"@id":"https://attack.mitre.org/techniques/T1190/","@type":"AttackTechnique","techniqueId":"T1190","name":"Exploit Public-Facing Application","tactic":[{"@id":"https://attack.mitre.org/tactics/TA0001/","@type":"AttackTactic","tacticId":"TA0001","shortname":"initial-access"}]}},{"@id":"urn:threatgraph:pkev-mapping:620","@type":"Mapping","mappingType":"secondary_impact","capabilityGroup":"code_execution","comments":"CVE-2021-44228, known as Log4Shell, affects Apache’s Log4j library, an open-source logging framework. An actor can exploit this vulnerability by submitting a specially crafted request to a vulnerable system that causes that system to execute arbitrary code. The request allows a cyber actor to take full control over the system. The actor can then steal information, launch ransomware, or conduct other malicious activity.","evidenceUrl":["https://www.cisa.gov/news-events/cybersecurity-advisories/aa22-117a","https://www.cisa.gov/sites/default/files/publications/CSRB-Report-on-Log4-July-11-2022_508.pdf","https://www.microsoft.com/en-us/security/blog/2021/12/11/guidance-for-preventing-detecting-and-hunting-for-cve-2021-44228-log4j-2-exploitation/#attacks","https://www.zdnet.com/article/log4j-flaw-attackers-are-making-thousands-of-attempts-to-exploit-this-severe-vulnerability/"],"wasDerivedFrom":["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc2219cdbb842e9a4e155afe"],"technique":{"@id":"https://attack.mitre.org/techniques/T1496/","@type":"AttackTechnique","techniqueId":"T1496","name":"Resource Hijacking","tactic":[{"@id":"https://attack.mitre.org/tactics/TA0040/","@type":"AttackTactic","tacticId":"TA0040","shortname":"impact"}]}},{"@id":"urn:threatgraph:pkev-mapping:621","@type":"Mapping","mappingType":"secondary_impact","capabilityGroup":"code_execution","comments":"CVE-2021-44228, known as Log4Shell, affects Apache’s Log4j library, an open-source logging framework. An actor can exploit this vulnerability by submitting a specially crafted request to a vulnerable system that causes that system to execute arbitrary code. The request allows a cyber actor to take full control over the system. The actor can then steal information, launch ransomware, or conduct other malicious activity.","evidenceUrl":["https://www.cisa.gov/news-events/cybersecurity-advisories/aa22-117a","https://www.cisa.gov/sites/default/files/publications/CSRB-Report-on-Log4-July-11-2022_508.pdf","https://www.microsoft.com/en-us/security/blog/2021/12/11/guidance-for-preventing-detecting-and-hunting-for-cve-2021-44228-log4j-2-exploitation/#attacks","https://www.zdnet.com/article/log4j-flaw-attackers-are-making-thousands-of-attempts-to-exploit-this-severe-vulnerability/"],"wasDerivedFrom":["https://github.com/center-for-threat-informed-defense/mappings-explorer/tree/ddc842aa48c871cbfc